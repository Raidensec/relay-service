RELAY_MODE=local
RELAY_DATABASE=relay.sqlite3
RELAY_INGRESS_SECRET=replace-with-a-random-long-value
RELAY_DEMO_SIGNING_SECRET=replace-with-a-different-random-long-value
RELAY_DESTINATIONS_JSON='{"demo":{"url":"http://127.0.0.1:9000/webhook","secret_ref":"env:RELAY_DEMO_SIGNING_SECRET"}}'
RELAY_MAX_ATTEMPTS=5
RELAY_RETRY_BASE_SECONDS=1
RELAY_RETRY_MAX_SECONDS=300
RELAY_REQUEST_TIMEOUT_SECONDS=10
